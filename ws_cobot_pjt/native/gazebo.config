<?xml version="1.0"?>
  <window>
    <width>1200</width>
    <height>800</height>
  </window>
  <plugin filename="MinimalScene" name="M0609 + RG2">
    <gz-gui>
      <property type="bool" key="showTitleBar">false</property>
      <property type="string" key="state">docked</property>
    </gz-gui>
    <engine>ogre2</engine>
    <scene>scene</scene>
    <ambient_light>0.5 0.5 0.5</ambient_light>
    <background_color>0.25 0.28 0.32</background_color>
    <camera_pose>2 -2 1.5 0 0.35 2.356</camera_pose>
  </plugin>
  <plugin filename="InteractiveViewControl" name="View control"/>
  <plugin filename="GzSceneManager" name="Scene manager"/>
  <plugin filename="EntityTree" name="Entities"/>
  <plugin filename="Screenshot" name="Screenshot"/>
